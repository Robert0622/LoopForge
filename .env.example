# LoopForge environment variables. Everything is optional: with no
# configuration `loopforge` starts on :8080 with SQLite under ~/.loopforge.
# `./start.sh` copies this file to `.env` on first run.

# ------------------------------------------
# One-click demo (./start.sh)
# ------------------------------------------
# Demo mode seeds a scripted SOP so you can click「一键演示」without an API key.
LOOPFORGE_DEMO_MODE=true
# Host port published by docker compose (maps to container :8080).
LOOPFORGE_PORT=8080
# Published image tag. Override when pin-ning a release.
# LOOPFORGE_VERSION=latest
# LOOPFORGE_IMAGE=ghcr.io/tencent/loopforge:latest

# ------------------------------------------
# Server & storage
# ------------------------------------------
LOOPFORGE_HTTP_PORT=8080
# Data directory for the SQLite database, session secret and workspaces.
# LOOPFORGE_DATA_DIR=/var/lib/loopforge
# sqlite:///path/loopforge.db or mysql://user:pass@tcp(host:3306)/loopforge
# LOOPFORGE_DATABASE_URL=
# Process role: all (default), api, or worker. Split deployments point the API
# at the worker control endpoint.
# LOOPFORGE_ROLE=all
# LOOPFORGE_WORKER_URL=http://127.0.0.1:8081
# LOOPFORGE_CONTROL_URL=http://127.0.0.1:8081
# LOOPFORGE_CONTROL_TOKEN=

# ------------------------------------------
# Accounts & sign-in
# ------------------------------------------
# First-boot admin. If the password is empty a random one is printed once.
# LOOPFORGE_ADMIN_USER=admin
# LOOPFORGE_ADMIN_PASSWORD=
# Comma-separated login names that are always platform admins.
# LOOPFORGE_PLATFORM_ADMINS=admin
# Cookie signing key; generated and persisted in the data dir when empty.
# LOOPFORGE_SESSION_SECRET=
# LOOPFORGE_COOKIE_DOMAIN=
# Force Secure cookies when TLS terminates at a proxy without X-Forwarded-Proto.
# LOOPFORGE_SECURE_COOKIES=false
# Public host shown in the "Connect" page (e.g. loopforge.example.com).
# LOOPFORGE_APP_DOMAIN=

# Trusted reverse-proxy identity (oauth2-proxy, Authelia, Pomerium, ...).
# Only enable when every request passes through a proxy that strips and
# re-injects the header.
# LOOPFORGE_TRUST_IDENTITY_HEADERS=false
# LOOPFORGE_IDENTITY_HEADER=X-Forwarded-User
# LOOPFORGE_TRUSTED_PROXY_CIDRS=10.0.0.0/8

# ------------------------------------------
# GitHub (issues, pull requests, repositories)
# ------------------------------------------
# Server-side token used by issue sync / import. Users can also store their
# own Git token in personal settings.
# LOOPFORGE_GITHUB_TOKEN=
# GitHub Enterprise Server: API base and web host.
# LOOPFORGE_GITHUB_API_URL=https://github.example.com/api/v3
# LOOPFORGE_GITHUB_HOST=github.example.com
# Domain appended to login names for commit authorship.
# LOOPFORGE_GIT_EMAIL_DOMAIN=users.noreply.loopforge.dev

# ------------------------------------------
# Agent execution
# ------------------------------------------
# Session-level MCP gateway used by clarification, assistant and scheduled tasks.
# LOOPFORGE_AGENT_TOOL_GATEWAY_URL=http://127.0.0.1:8080
# Prebuilt runner / gate MCP binaries; {os} and {arch} are substituted.
# LOOPFORGE_RUNNER_BINARY=/opt/loopforge/loopforge-runner-{os}-{arch}
# LOOPFORGE_GATE_MCP_BINARY=/opt/loopforge/loopforge-gate-mcp-{os}-{arch}
# Address agent sandboxes use to reach this server (without /mcp). Roles with
# the platform MCP toggle depend on it. Required for split workers, and it must
# be reachable from inside the sandbox (not 127.0.0.1 for Docker sandboxes).
# Execution machines ignore it and use their own server URL.
# LOOPFORGE_PLATFORM_MCP_URL=
# Bearer token for the platform MCP endpoint (/mcp).
# LOOPFORGE_PLATFORM_MCP_TOKEN=
# Remote runners register with this token.
# LOOPFORGE_RUNNER_BOOTSTRAP_TOKEN=
# When LoopForge runs in a container with the host's Docker socket, sandbox
# bind mounts are translated through its own mounts and sandboxes join its
# network. Override the detected container name or network if needed.
# LOOPFORGE_DOCKER_SELF=loopforge
# LOOPFORGE_DOCKER_NETWORK=loopforge_default
# Absolute path where workers keep Codex / CodeBuddy / Claude Code up to date
# for the built-in runner. Unset disables managed updates (docs/managed-cli.md).
# LOOPFORGE_MANAGED_CLI_ROOT=/srv/loopforge/managed-cli
# Model credentials (Claude Code / Codex / CodeBuddy API keys) are configured
# per user in personal settings, not here.

# ------------------------------------------
# Observability
# ------------------------------------------
# LOOPFORGE_OTEL_ENDPOINT=http://otel-collector:4318

# ------------------------------------------
# Extensions (see docs/extending.md)
# ------------------------------------------
# Comma-separated files, directories or http(s) URLs, read at startup.
# Extra MCP market entries; an entry with a built-in id replaces it.
# LOOPFORGE_MCP_MARKET=/etc/loopforge/mcp-market.json
# Market ids installed on every project (default: github).
# LOOPFORGE_DEFAULT_PROJECT_MCPS=github
# Extra platform SOP templates; bump Workflow.version to roll out updates.
# LOOPFORGE_TEMPLATES=/etc/loopforge/templates
# .js/.css files loaded into the web UI (window.LoopForge API).
# LOOPFORGE_WEB_PLUGINS=/etc/loopforge/plugins
